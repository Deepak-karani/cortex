{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@agents/*": ["agents/*"],
      "@tools/*": ["tools/*"],
      "@sim/*": ["sim/*"],
      "@memory/*": ["memory/*"]
    }
  },
  "include": ["src/**/*", "agents/**/*", "tools/**/*", "sim/**/*", "memory/**/*"]
}
