# Cortex Arena · environment configuration
#
# In the current Spark deployment, the only inference surface exposed by the
# DGX is the team's Oracle backend on port 8000. Cortex routes its visible
# LLM output (Socratic questions) through that endpoint; everything else
# runs as fast deterministic local reasoning.

# Team's Oracle backend — wraps Nemotron-3-Super on the Spark.
# Without this set, Cortex falls back to a local Socratic bank.
ORACLE_BACKEND_URL=http://100.80.177.127:8000

# Optional vision (VLM) endpoint. Any OpenAI-compatible /chat/completions
# endpoint that accepts image_url inputs. If unset, Cortex falls back to a
# smart OCR-based heuristic analyzer for screen understanding.
VISION_BASE_URL=
VISION_API_KEY=local
VISION_MODEL=nvidia/vlm-or-fastvlm

PORT=4000
CLIENT_ORIGIN=http://localhost:5173
