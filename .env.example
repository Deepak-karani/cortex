NEMOTRON_BASE_URL=http://localhost:8000/v1
NEMOTRON_API_KEY=local
NEMOTRON_MODEL=nvidia/Nemotron-super-120b

# When set, Cortex routes its Socratic-question requests through your team's
# Oracle backend (port 8000) instead of the OpenAI-compatible Nemotron endpoint.
# This way Cortex shares the SAME Nemotron-3-Super instance that the team's
# Oracle uses — no second model load on the Spark.
#
#   ORACLE_BACKEND_URL=http://100.80.177.127:8000
ORACLE_BACKEND_URL=

# Optional VLM (Vision-Language Model) endpoint for screen analysis.
# Any OpenAI-compatible /chat/completions endpoint that accepts image_url.
# NVIDIA VLM, FastVLM, or local VLMs (e.g. Ollama llava/qwen2-vl) all work.
# If unset, Cortex falls back to a smart OCR-based heuristic analyzer.
VISION_BASE_URL=
VISION_API_KEY=local
VISION_MODEL=nvidia/vlm-or-fastvlm

PORT=4000
CLIENT_ORIGIN=http://localhost:5173
